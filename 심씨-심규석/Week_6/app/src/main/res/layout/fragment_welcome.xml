<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/img_welcom_bg" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="70dp"
        android:layout_height="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/welcomeText"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="48dp"
        app:srcCompat="@drawable/ic_splash_logo" />

    <TextView
        android:id="@+id/welcomeText"
        style="@style/Text.Medium"
        android:textSize="28sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="50dp"
        app:layout_constraintBottom_toTopOf="@id/buttonLayout"
        android:layout_marginBottom="24dp"
        android:text=
            "무료 배송, 멤버 전용 상품,\n세상에 하나뿐인 나만의\n나이키를 즐겨보세요."
        />

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:layout_marginBottom="50dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/signUpButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/black"

            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="가입하기" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/signInButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            style="@style/Widget.App.Card.Corner50"
            android:backgroundTint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toTopOf="@id/addCartButton"

            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:text="로그인" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>