<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/HomeFragment">
    <fragment
        android:id="@+id/HomeFragment"
        tools:layout="@layout/fragment_home"
        android:name="com.umc.myapplication.presentation.fragment.HomeFragment"
        android:label="홈">

        <action
            android:id="@+id/action_HomeFragment_to_BannerDetailFragment"
            app:destination="@id/BannerDetailFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_ProductDetailFragment"
            app:destination="@id/ProductDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/SearchFragment"
        tools:layout="@layout/fragment_search"
        android:name="com.umc.myapplication.presentation.fragment.SearchFragment"
        android:label="구매하기">
        <argument
            android:name="isWishList"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_SearchFragment_to_ProductDetailFragment"
            app:destination="@id/ProductDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/WishListFragment"
        tools:layout="@layout/fragment_wish_list"
        android:name="com.umc.myapplication.presentation.fragment.WishListFragment"
        android:label="위시리스트">
        <action
            android:id="@+id/action_WishListFragment_to_ProductDetailFragment"
            app:destination="@id/ProductDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/CartFragment"
        tools:layout="@layout/fragment_cart"
        android:name="com.umc.myapplication.presentation.fragment.CartFragment"
        android:label="장바구니">
        <argument
            android:name="productId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_CartFragment_to_SearchFragment"
            app:destination="@id/SearchFragment" />
    </fragment>
    <fragment
        android:id="@+id/ProfileFragment"
        tools:layout="@layout/fragment_profile"
        android:name="com.umc.myapplication.presentation.fragment.ProfileFragment"
        android:label="프로필">
    </fragment>
    <fragment
        android:id="@+id/BannerDetailFragment"
        tools:layout="@layout/fragment_banner_detail"
        android:name="com.umc.myapplication.presentation.fragment.BannerDetailFragment"
        android:label="배너 디테일">
        <argument android:name="resId" app:argType="reference" />
        <argument android:name="title" app:argType="string" />
        <argument android:name="description" app:argType="string" />
        <action
            android:id="@+id/action_BannerDetailFragment_to_HomeFragment"
            app:destination="@id/HomeFragment" />
    </fragment>
    <fragment
        android:id="@+id/ProductDetailFragment"
        tools:layout="@layout/fragment_product_detail"
        android:name="com.umc.myapplication.presentation.fragment.ProductDetailFragment"
        android:label="ProductDetailFragment" >
        <argument
            android:name="productId"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_ProductDetailFragment_to_SearchFragment"
            app:destination="@id/SearchFragment" />
        <action
            android:id="@+id/action_ProductDetailFragment_to_CartFragment"
            app:destination="@id/CartFragment" />
    </fragment>
</navigation>