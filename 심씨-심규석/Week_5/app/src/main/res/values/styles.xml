<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="App.TextInput.Outlined.Flat" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <style name="Widget.App.Card.Corner50" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Corner50</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/gray300</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Corner50" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <!-- 수평 바(ConstraintLayout에서 폭을 제약으로 결정할 때) -->
    <style name="HorizontalLine">
        <item name="android:layout_height">2dp</item>
        <item name="android:background">@color/gray600</item>
    </style>

    <!-- 수직 바: 세로로 구분하는 얇은 선 -->
    <style name="VerticalLine">
        <item name="android:layout_width">2dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/gray600</item>
    </style>
    <style name="Text"/>
    <style name="Text.Base">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Reguler" parent="Text.Base">
        <item name="android:fontFamily">@font/notosanskr_regular</item>
    </style>

    <style name="Text.Medium" parent="Text.Base">
        <item name="android:fontFamily">@font/notosanskr_medium</item>
    </style>
</resources>